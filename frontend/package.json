    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.62.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5.2.2",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
