# Copiar a .env y completar. .env no se versiona.
POSTGRES_DB=genrecursos
POSTGRES_USER=genrecursos
POSTGRES_PASSWORD=cambiar
DB_PORT=15432
# Carpeta con la documentación oficial de las carreras (fuera del repositorio)
DOCS_CARRERAS=C:/ruta/a/Documentacion carreras
# Datos estructurados de otros proyectos (kb/importar_estructurados.py)
SILABOS_SALIDA=C:/ruta/a/SILABOS/salida
PERFILES_EGRESO=C:/ruta/a/AGENTE-EMPLEO/docs/perfiles-egreso

# --- Backend (P1 · núcleo multiagente) ---
DATABASE_URL=postgresql://genrecursos:cambiar@127.0.0.1:15432/genrecursos
LLM_BASE_URL=http://172.16.8.69:8000/v1
LLM_MODEL=Qwen/Qwen3-8B-AWQ
LLM_API_KEY=no-se-necesita
LLM_MAX_CONCURRENCIA=4
LLM_TIMEOUT_S=120
LLM_TIMEOUT_REVISOR_S=240
LEASE_S=360
AGENTES_DIR=agentes
